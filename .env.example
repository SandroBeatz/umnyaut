# Copy to apps/web/.env.local for local development. Never commit real values.
# Validated at server start by apps/web/server/platform/env.ts.

# local | preview | staging | production (non-production adds noindex, disables analytics)
APP_ENV=local

# Supabase (server-only access)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_ROOT=

# AI vision provider (Gemini API; GEMINI_BASE_URL = relay outside RU/BY, which the API does not serve)
GEMINI_API_KEY=
GEMINI_BASE_URL=
AI_ENABLED=false
AI_MONTHLY_BUDGET_USD=0

# Analytics and indexing
METRIKA_ID=
INDEXNOW_KEY=
