{
	email {$ACME_EMAIL}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
		-X-Powered-By
	}
}

(access_log) {
	log {
		output stdout
		# No full IPs in logs: keep the /24 (IPv4) or /48 (IPv6) subnet only.
		format filter {
			request>remote_ip ip_mask 24 48
			request>client_ip ip_mask 24 48
			request>headers>X-Forwarded-For delete
			request>headers>Cookie delete
			# The owner's token of a shared estimate (PUT/DELETE /api/projects/<id>/).
			request>headers>X-Edit-Token delete
		}
	}
}

www.{$DOMAIN} {
	import security_headers
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	import security_headers
	import access_log
	encode zstd gzip

	# The app caps JSON at 64 KB; 4 MB leaves room for the AI photo routes (tech spec §9).
	request_body /api/* {
		max_size 4MB
	}

	# Only the canonical domain is indexable; a temporary DOMAIN (e.g. <ip>.sslip.io before DNS) is not.
	@noncanonical expression {host} != "umnyaut.com"
	header @noncanonical X-Robots-Tag "noindex, nofollow"

	# Written by deploy.sh: `reverse_proxy web-blue:3000` or `reverse_proxy web-green:3000`.
	import /etc/caddy/state/upstream.caddy
}
