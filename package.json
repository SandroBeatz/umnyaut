{
  "name": "umnyaut",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "turbo run dev --filter=web",
    "lint": "biome check .",
    "format": "biome check --write .",
    "guard": "node tooling/scripts/check-boundaries.mjs",
    "steiger": "steiger apps/web/src",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "check": "pnpm lint && pnpm guard && pnpm steiger && turbo run typecheck test build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@feature-sliced/steiger-plugin": "0.8.0",
    "@vitest/coverage-v8": "5.0.3",
    "steiger": "0.7.0",
    "turbo": "2.11.7",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
